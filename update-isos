#!/usr/bin/env bash
# update-isos.sh
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/progress.sh
[[ -f "$SCRIPT_DIR/lib/progress.sh" ]] && source "$SCRIPT_DIR/lib/progress.sh"
# shellcheck source=lib/update-tools
source "$SCRIPT_DIR/lib/update-tools"

# The staged download, global so the EXIT trap can remove it after a Ctrl+C:
# a half-downloaded ISO is useless, and a hidden .part file is easy to forget.
tmp_download=""

cleanup() {
    [[ -n "$tmp_download" ]] && rm -f "$tmp_download"
    return 0
}

# Names in a server's directory listing, folders with a trailing "/". Copes with
# plain index pages and SourceForge (absolute links ending in "/download").
list_dir() {
    curl -fsL "${CURL_META[@]}" "$1" | grep -oE 'href="[^"]+"' | awk '
        { h = substr($0, 7, length($0) - 7); sub(/[?#].*/, "", h); sub(/\/download$/, "", h)
          dir = (h ~ /\/$/); sub(/\/$/, "", h); n = split(h, p, "/"); name = p[n]
          if (name != "" && name != "." && name != "..") print name (dir ? "/" : "") }' | sort -u
}

# The stdin entries matching glob $1, newest first, judged by the numbers in the
# part the wildcards matched: EndeavourOS_Titan-Nova-2026.08.15 must beat
# Ganymede-Neo-2026.01.12, and the fixed "amd64" in a name must not count.
sort_newest() {
    local glob="$1" name head tail
    head="${glob%%[\[*?]*}"; tail="${glob##*\*}"
    while IFS= read -r name; do
        # shellcheck disable=SC2053
        [[ "$name" == $glob ]] && printf '%s\n' "$name"
    done | awk -v h="${#head}" -v t="${#tail}" '
        { k = substr($0, h + 1, length($0) - h - t); gsub(/[^0-9]+/, ".", k); gsub(/^\.|\.$/, "", k)
          print k "\t" $0 }' | sort -t $'\t' -k1,1Vr -k2,2Vr | cut -f2
}

# $1 = URL so far (ending in "/"), rest = the remaining path segments. A glob in a
# folder falls back to the next-newest match (up to 3) when the rest finds nothing,
# e.g. a new release folder that so far holds only a beta.
resolve_segments() {
    local prefix="$1" seg="$2" cand
    shift 2
    (( $# )) && seg+="/"
    if [[ "$seg" != *'*'* && "$seg" != *'['* ]]; then
        if (( $# )); then resolve_segments "$prefix$seg" "$@"; else printf '%s\n' "$prefix$seg"; fi
        return
    fi
    while IFS= read -r cand; do
        if (( $# == 0 )); then
            printf '%s\n' "$prefix$cand"
            return 0
        fi
        resolve_segments "$prefix$cand" "$@" && return 0
    done < <(list_dir "$prefix" | sort_newest "$seg" | head -n 3)
    return 1
}

# Expand each glob segment of URL $1 against the server's listings. Prints the URL.
# Runs inside $(...), so the caller reports a failure: a say here would be captured.
resolve_glob_url() {
    local -a segs
    IFS=/ read -ra segs <<<"${1#*://}"
    resolve_segments "${1%%://*}://${segs[0]}/" "${segs[@]:1}"
}

# "<algo> <hash>" for file $2 in checksum text $1. Reads GNU lines ("hash  name",
# "hash *name", "hash  ./name") and BSD lines ("SHA256 (name) = hash"), matching
# on the file name alone (Ultramarine lists build paths); sha512 wins over sha256,
# and md5/sha1 entries are ignored.
checksum_for() {
    awk -v want="$2" '
        { name = ""; hash = "" }
        /^[A-Za-z0-9-]+ \(.*\) = [0-9a-fA-F]+$/ {
            name = $0; sub(/^[^(]*\(/, "", name); sub(/\) = [0-9a-fA-F]+$/, "", name); hash = $NF }
        /^[0-9a-fA-F]+ [ *]/ {
            hash = $1; name = $0; sub(/^[0-9a-fA-F]+ [ *]/, "", name); sub(/^ ?\*?(\.\/)?/, "", name) }
        { sub(/^.*\//, "", name) }
        hash != "" && name == want {
            n = length(hash); if ((n == 64 || n == 128) && n > best) { best = n; h = hash } }
        END { if (best) print (best == 128 ? "sha512" : "sha256"), tolower(h) }' <<<"$1"
}

hash_file() {
    local sum
    read -r sum _ < <("${1}sum" "$2" 2>/dev/null)
    printf '%s\n' "${sum:-}"
}

# Sets iso_url (what to download), iso_name and sum_url, and for static the
# version and server details static_head finds. Returns 1 to skip.
# Sets nothing_newer=1 when dateprobe found no build past the installed one.
resolve_iso() {
    local dir_url cand day today_s now sum c cur_date
    iso_url="" iso_name="" sum_url="" nothing_newer=0
    # only static sets these; clear the previous item's
    latest_tag="" remote_length="" remote_modified="" remote_etag=""
    if [[ -z "${url:-}" || -z "${checksum:-}" ]]; then
        say "⚠ ${PROGRESS_LABEL:-}: cfg needs url and checksum, skipping"
        return 1
    fi
    case "${manager:-}" in
        dirlist)
            if ! iso_url=$(resolve_glob_url "$url"); then
                say "⚠ ${PROGRESS_LABEL:-}: nothing on the server matches ${url##*/}, skipping"
                return 1
            fi
            iso_name="${iso_url##*/}"
            dir_url="${iso_url%/*}/"
            iso_url+="${download_suffix:-}"
            ;;
        static)
            # the name comes from where the URL lands (Garuda's latest.iso redirects)
            static_head "$url" || return 1
            iso_name="$asset_name"
            iso_url="$url"
            dir_url="${url%/*}/"
            ;;
        dateprobe)
            # no listing (Nobara's bucket): try dates from today back, stopping at
            # the installed one; each try is one small HEAD request
            [[ "${installed_file:-}" =~ [0-9]{4}-[0-9]{2}-[0-9]{2} ]] && cur_date="${BASH_REMATCH[0]}"
            printf -v now '%(%s)T' -1
            for (( day = 0; day <= ${probe_days:-90}; day++ )); do
                printf -v today_s '%(%F)T' $(( now - day * 86400 ))
                [[ -n "${cur_date:-}" && "$today_s" < "$cur_date" ]] && break
                cand="${url//\{date\}/$today_s}"
                c="$checksum"; c="${c//\{iso\}/${cand##*/}}"
                [[ "$c" == *://* ]] || c="${cand%/*}/$c"
                if curl -fsI "${CURL_META[@]}" -o /dev/null "$c"; then
                    iso_url="$cand"; sum_url="$c"; break
                fi
            done
            if [[ -z "$iso_url" ]]; then
                if [[ -n "${cur_date:-}" ]]; then
                    # nothing newer; the installed build may already be gone from the
                    # server, so don't ask for its checksum file
                    nothing_newer=1
                    iso_name="$installed_file"
                    debug "no build newer than $cur_date on the server"
                    return 0
                else
                    say "⚠ ${PROGRESS_LABEL:-}: no ${url##*/} found in the last ${probe_days:-90} days, skipping"
                    return 1
                fi
            fi
            iso_name="${iso_url##*/}"
            dir_url="${iso_url%/*}/"
            ;;
        *)
            say "⚠ ${PROGRESS_LABEL:-}: unknown or missing manager '${manager:-}', skipping"
            return 1
            ;;
    esac

    if [[ -z "$sum_url" ]]; then
        sum="$checksum"; sum="${sum//\{iso\}/$iso_name}"
        [[ "$sum" == *://* ]] || sum="$dir_url$sum"
        if [[ "$sum" == *'*'* || "$sum" == *'['* ]]; then
            if ! sum=$(resolve_glob_url "$sum"); then
                say "⚠ ${PROGRESS_LABEL:-}: no checksum file matches ${sum##*/}, skipping"
                return 1
            fi
        fi
        sum_url="$sum"
    fi
}

# One cfg: check it, and update it if needed.
process_item() {
    local i="$1"
    local sum_text algo want got size avail sum_name
    local iso_url iso_name sum_url nothing_newer
    cfg_file="${cfg_files[$i]}"
    name="${cfg_file##*/}"
    name="${name%.iso.cfg}"

    PROGRESS_DONE=$i
    PROGRESS_LABEL="$name"
    STATUS=""
    block_redraw

    load_cfg "$cfg_file"
    debug "cfg: manager=${manager:-?} folder=${folder:-none} installed_file=${installed_file:-none} last_checked=${last_checked:-never}"
    # folder= is relative to the root, so -r still works; it may not leave it
    folder="${folder:-}"; folder="${folder%/}"
    if [[ -z "$folder" || "$folder" == /* || "/$folder/" == */../* ]]; then
        say "⚠ $name: folder must be a path inside $ISO_DIR, like Linux/Fedora/Fedora, skipping"
        return 0
    fi
    dir="$ISO_DIR/$folder"

    installed_path=$(find_installed "$dir")
    if [[ -n "$installed_path" ]]; then
        debug "installed file: ${installed_path##*/}"
    else
        debug "not installed yet: installing it"
    fi

    if [[ "$force" == false && -n "$installed_path" && "${last_checked:-}" == "$today" ]]; then
        status_final "✓ already checked today (${current_version:-$installed_file})"
        return 0
    fi

    if ! resolve_iso; then
        return 0
    fi
    if (( nothing_newer )); then
        if [[ -n "$installed_path" ]]; then
            status_final "✓ up to date ($installed_file)"
            [[ "$check_only" == true ]] || save_update_metadata "$cfg_file"
        else
            say "⚠ $name: $installed_file is missing and the server has nothing newer, skipping"
        fi
        return 0
    fi

    debug "newest: $iso_name"
    debug "download URL: $iso_url"
    debug "checksum file: $sum_url"
    if ! sum_text=$(curl -fsL "${CURL_META[@]}" "$sum_url"); then
        say "⚠ $name: could not fetch checksum file $sum_url, skipping"
        return 0
    fi
    read -r algo want <<<"$(checksum_for "$sum_text" "$iso_name")"
    [[ -n "${want:-}" ]] && debug "expected $algo ${want:0:16}…"
    if [[ -z "${want:-}" ]]; then
        say "⚠ $name: $iso_name isn't listed in ${sum_url##*/}, skipping"
        return 0
    fi

    if [[ -n "$installed_path" ]]; then
        # first run, or the checksum algorithm changed: hash the installed ISO once
        if [[ "${iso_hash:-}" != "$algo:"* ]]; then
            status "🔍 hashing $installed_file"
            iso_hash="$algo:$(hash_file "$algo" "$installed_path")"
        fi
        debug "installed ${iso_hash:0:23}…"
        if [[ "$iso_hash" == "$algo:$want" ]]; then
            status_final "✓ up to date (${latest_tag:-$installed_file})"
            [[ "$check_only" == true ]] || save_update_metadata "$cfg_file"
            return 0
        fi
    fi

    # -c: report it, download and write nothing
    if [[ "$check_only" == true ]]; then
        status_final "⬆ update available: ${latest_tag:-$iso_name}"
        return 0
    fi

    mkdir -p "$dir"
    size=$(curl -fsIL "${CURL_META[@]}" "$iso_url" | awk 'tolower($1) == "content-length:" { v = $2 } END { sub(/\r/, "", v); print v }')
    avail=$(df --output=avail -B1 "$dir" | tail -n 1)
    debug "size ${size:-unknown} bytes, $(( avail >> 20 )) MiB free"
    # keep 256 MiB spare; the old ISO stays until the new one verifies
    if [[ "$size" =~ ^[0-9]+$ ]] && (( size + 268435456 > avail )); then
        say "⚠ $name: not enough space for $iso_name ($(( size >> 20 )) MiB + 256 MiB spare needed, $(( avail >> 20 )) MiB free), skipping"
        return 0
    fi

    if [[ -n "$installed_path" ]]; then
        status "⬆ updating"
    else
        status "⬇ installing"
    fi

    # next to the ISO (same filesystem, so installing is a rename), hidden and not
    # ending in .iso so Ventoy never lists a partial download
    tmp_download="$dir/.$iso_name.part"

    curl_takeover
    if ! curl_run -fL "${CURL_DL[@]}" --progress-bar "$iso_url" -o "$tmp_download"; then
        curl_abandon
        say "  ✗ Failed to download update for $name"
        rm -f "$tmp_download"; tmp_download=""
        return 0
    fi
    curl_handback
    debug "downloaded to $tmp_download"

    status "🔍 verifying $iso_name"
    got=$(hash_file "$algo" "$tmp_download")
    debug "downloaded file's $algo: ${got:0:16}…"
    if [[ "$got" != "$want" ]]; then
        say "  ✗ $name: checksum mismatch for $iso_name, download deleted"
        rm -f "$tmp_download"; tmp_download=""
        return 0
    fi

    mv -f "$tmp_download" "$dir/$iso_name"
    tmp_download=""
    [[ -n "$installed_path" && "$installed_path" != "$dir/$iso_name" ]] && rm -f "$installed_path"

    sum_name="${checksum_save:-${sum_url##*/}}"
    sum_name="${sum_name//\{iso\}/$iso_name}"
    printf '%s\n' "$sum_text" > "$dir/$sum_name"
    [[ -n "${checksum_file:-}" && "$checksum_file" != "$sum_name" ]] && rm -f "$dir/$checksum_file"

    installed_file="$iso_name" iso_hash="$algo:$want" checksum_file="$sum_name"
    save_update_metadata "$cfg_file"
    status_final "✓ updated to ${latest_tag:-$iso_name}"
}

# Fills in the shared help text in common.sh.
USAGE_ITEM="ISO"
USAGE_ABOUT="Check and update the ISOs on the Ventoy drive (/mnt/ventoy/_ISO), one
NAME.iso.cfg per ISO in its .cfg folder, whose folder= key names the ISO's
folder below it (like Linux/Fedora/Fedora). Every download is checksum-verified
before it replaces anything."
USAGE_ROOT="/mnt/ventoy/_ISO (the drive's _ISO folder)"

# Fills in main in lib/update-tools.
ITEM_TYPE="iso"
ITEM_EXT="iso"
DEFAULT_DIR="/mnt/ventoy/_ISO"
NOT_FOUND_HINT="Is the Ventoy drive mounted? Point to it with -r DIR."

prepare_dir() {
    # process_item points dir at each ISO's folder, so keep the root
    ISO_DIR="$dir"
    # left over from a run that was killed outright (Ctrl+C cleans up after itself)
    find "$dir" -mindepth 1 -name '.*.iso.part' -type f -delete
}

main "$@"
