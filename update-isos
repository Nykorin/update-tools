#!/usr/bin/env bash
# update-isos.sh
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/progress.sh
[[ -f "$SCRIPT_DIR/lib/progress.sh" ]] && source "$SCRIPT_DIR/lib/progress.sh"
# shellcheck source=lib/update-tools
source "$SCRIPT_DIR/lib/update-tools"

# The staged download, global so the EXIT trap can remove it after a Ctrl+C:
# a half-downloaded ISO is useless, and a hidden .part file is easy to forget.
tmp_download=""

cleanup() {
    [[ -n "$tmp_download" ]] && rm -f "$tmp_download"
    return 0
}

# "<algo> <hash>" for file $2 in checksum text $1. Reads GNU lines ("hash  name",
# "hash *name", "hash  ./name") and BSD lines ("SHA256 (name) = hash"), matching
# on the file name alone (Ultramarine lists build paths); sha512 wins over sha256,
# and md5/sha1 entries are ignored.
checksum_for() {
    awk -v want="$2" '
        { name = ""; hash = "" }
        /^[A-Za-z0-9-]+ \(.*\) = [0-9a-fA-F]+$/ {
            name = $0; sub(/^[^(]*\(/, "", name); sub(/\) = [0-9a-fA-F]+$/, "", name); hash = $NF }
        /^[0-9a-fA-F]+ [ *]/ {
            hash = $1; name = $0; sub(/^[0-9a-fA-F]+ [ *]/, "", name); sub(/^ ?\*?(\.\/)?/, "", name) }
        { sub(/^.*\//, "", name) }
        hash != "" && name == want {
            n = length(hash); if ((n == 64 || n == 128) && n > best) { best = n; h = hash } }
        END { if (best) print (best == 128 ? "sha512" : "sha256"), tolower(h) }' <<<"$1"
}

hash_file() {
    local sum
    read -r sum _ < <("${1}sum" "$2" 2>/dev/null)
    printf '%s\n' "${sum:-}"
}

# Sets iso_url (what to download), iso_name and sum_url through the shared
# managers (static, dirlist, dateprobe). Returns 1 to skip.
# Sets nothing_newer=1 when dateprobe found no build past the installed one.
resolve_iso() {
    local dir_url sum
    iso_url="" iso_name="" sum_url="" nothing_newer=0
    if [[ -z "${url:-}" || -z "${checksum:-}" ]]; then
        say "⚠ ${PROGRESS_LABEL:-}: cfg needs url and checksum, skipping"
        return 1
    fi
    case "${manager:-}" in
        static|dirlist|dateprobe) ;;
        *)
            say "⚠ ${PROGRESS_LABEL:-}: unknown or missing manager '${manager:-}', skipping"
            return 1
            ;;
    esac
    resolve_latest_asset || return 1
    if (( remote_unchanged )); then
        # the installed build may already be gone from the server, so don't ask
        # for its checksum file
        nothing_newer=1
        iso_name="$installed_file"
        return 0
    fi
    iso_name="$asset_name"
    iso_url="$asset_url"
    # a relative checksum is next to the ISO; for static, next to the cfg's URL
    # (Garuda's latest.iso.sha256 sits beside latest.iso, not where it redirects)
    if [[ "$manager" == static ]]; then
        dir_url="${url%/*}/"
    else
        dir_url="${asset_url%"${download_suffix:-}"}"
        dir_url="${dir_url%/*}/"
    fi

    sum="$checksum"; sum="${sum//\{iso\}/$iso_name}"
    [[ "$sum" == *://* ]] || sum="$dir_url$sum"
    if [[ "$sum" == *'*'* || "$sum" == *'['* ]]; then
        if ! sum=$(resolve_glob_url "$sum"); then
            say "⚠ ${PROGRESS_LABEL:-}: no checksum file matches ${sum##*/}, skipping"
            return 1
        fi
    fi
    sum_url="$sum"
}

# One cfg: check it, and update it if needed.
process_item() {
    local i="$1"
    local sum_text algo want got size avail sum_name
    local iso_url iso_name sum_url nothing_newer
    cfg_file="${cfg_files[$i]}"
    name="${cfg_file##*/}"
    name="${name%.iso.cfg}"

    PROGRESS_DONE=$i
    PROGRESS_LABEL="$name"
    STATUS=""
    block_redraw

    load_cfg "$cfg_file"
    debug "cfg: manager=${manager:-?} folder=${folder:-none} installed_file=${installed_file:-none} last_checked=${last_checked:-never}"
    # folder= is relative to the root, so -r still works; it may not leave it
    folder="${folder:-}"; folder="${folder%/}"
    if [[ -z "$folder" || "$folder" == /* || "/$folder/" == */../* ]]; then
        say "⚠ $name: folder must be a path inside $ISO_DIR, like Linux/Fedora/Fedora, skipping"
        return 0
    fi
    dir="$ISO_DIR/$folder"

    installed_path=$(find_installed "$dir")
    if [[ -n "$installed_path" ]]; then
        debug "installed file: ${installed_path##*/}"
    else
        debug "not installed yet: installing it"
    fi

    if [[ "$force" == false && -n "$installed_path" && "${last_checked:-}" == "$today" ]]; then
        status_final "✓ already checked today (${current_version:-$installed_file})"
        return 0
    fi

    if ! resolve_iso; then
        return 0
    fi
    if (( nothing_newer )); then
        if [[ -n "$installed_path" ]]; then
            status_final "✓ up to date ($installed_file)"
            [[ "$check_only" == true ]] || save_update_metadata "$cfg_file"
        else
            say "⚠ $name: $installed_file is missing and the server has nothing newer, skipping"
        fi
        return 0
    fi

    debug "checksum file: $sum_url"
    if ! sum_text=$(curl -fsL "${CURL_META[@]}" "$sum_url"); then
        say "⚠ $name: could not fetch checksum file $sum_url, skipping"
        return 0
    fi
    read -r algo want <<<"$(checksum_for "$sum_text" "$iso_name")"
    [[ -n "${want:-}" ]] && debug "expected $algo ${want:0:16}…"
    if [[ -z "${want:-}" ]]; then
        say "⚠ $name: $iso_name isn't listed in ${sum_url##*/}, skipping"
        return 0
    fi

    if [[ -n "$installed_path" ]]; then
        # first run, or the checksum algorithm changed: hash the installed ISO once
        if [[ "${iso_hash:-}" != "$algo:"* ]]; then
            status "🔍 hashing $installed_file"
            iso_hash="$algo:$(hash_file "$algo" "$installed_path")"
        fi
        debug "installed ${iso_hash:0:23}…"
        if [[ "$iso_hash" == "$algo:$want" ]]; then
            status_final "✓ up to date (${latest_tag:-$installed_file})"
            [[ "$check_only" == true ]] || save_update_metadata "$cfg_file"
            return 0
        fi
    fi

    # -c: report it, download and write nothing
    if [[ "$check_only" == true ]]; then
        status_final "⬆ update available: ${latest_tag:-$iso_name}"
        return 0
    fi

    mkdir -p "$dir"
    size=$(curl -fsIL "${CURL_META[@]}" "$iso_url" | awk 'tolower($1) == "content-length:" { v = $2 } END { sub(/\r/, "", v); print v }')
    avail=$(df --output=avail -B1 "$dir" | tail -n 1)
    debug "size ${size:-unknown} bytes, $(( avail >> 20 )) MiB free"
    # keep 256 MiB spare; the old ISO stays until the new one verifies
    if [[ "$size" =~ ^[0-9]+$ ]] && (( size + 268435456 > avail )); then
        say "⚠ $name: not enough space for $iso_name ($(( size >> 20 )) MiB + 256 MiB spare needed, $(( avail >> 20 )) MiB free), skipping"
        return 0
    fi

    if [[ -n "$installed_path" ]]; then
        status "⬆ updating"
    else
        status "⬇ installing"
    fi

    # next to the ISO (same filesystem, so installing is a rename), hidden and not
    # ending in .iso so Ventoy never lists a partial download
    tmp_download="$dir/.$iso_name.part"

    curl_takeover
    if ! curl_run -fL "${CURL_DL[@]}" --progress-bar "$iso_url" -o "$tmp_download"; then
        curl_abandon
        say "  ✗ Failed to download update for $name"
        rm -f "$tmp_download"; tmp_download=""
        return 0
    fi
    curl_handback
    debug "downloaded to $tmp_download"

    status "🔍 verifying $iso_name"
    got=$(hash_file "$algo" "$tmp_download")
    debug "downloaded file's $algo: ${got:0:16}…"
    if [[ "$got" != "$want" ]]; then
        say "  ✗ $name: checksum mismatch for $iso_name, download deleted"
        rm -f "$tmp_download"; tmp_download=""
        return 0
    fi

    mv -f "$tmp_download" "$dir/$iso_name"
    tmp_download=""
    [[ -n "$installed_path" && "$installed_path" != "$dir/$iso_name" ]] && rm -f "$installed_path"

    sum_name="${checksum_save:-${sum_url##*/}}"
    sum_name="${sum_name//\{iso\}/$iso_name}"
    printf '%s\n' "$sum_text" > "$dir/$sum_name"
    [[ -n "${checksum_file:-}" && "$checksum_file" != "$sum_name" ]] && rm -f "$dir/$checksum_file"

    installed_file="$iso_name" iso_hash="$algo:$want" checksum_file="$sum_name"
    save_update_metadata "$cfg_file"
    status_final "✓ updated to ${latest_tag:-$iso_name}"
}

# Picks this updater's settings in lib/update-tools.
ITEM_TYPE="iso"

prepare_dir() {
    # process_item points dir at each ISO's folder, so keep the root
    ISO_DIR="$dir"
    # left over from a run that was killed outright (Ctrl+C cleans up after itself)
    find "$dir" -mindepth 1 -name '.*.iso.part' -type f -delete
}

main "$@"
