#!/usr/bin/env bash
# update-apworlds.sh
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/progress.sh
[[ -f "$SCRIPT_DIR/lib/progress.sh" ]] && source "$SCRIPT_DIR/lib/progress.sh"

# The staged download, global so the EXIT trap can remove it after a Ctrl+C.
tmp_download=""

cleanup() {
    rm -f "$GITHUB_HEADERS"
    [[ -n "$tmp_download" ]] && rm -f "$tmp_download"
    return 0
}

unbundle_apworld() {
    local pattern="${apworld_filename:-*.apworld}"
    local entry base member extracted list
    local -a matches=()

    grep -qi '\.apworld$' <<<"$zip_listing" || return 0

    while IFS= read -r entry; do
        [[ "$entry" == */ ]] && continue
        base="${entry##*/}"
        # shellcheck disable=SC2053
        [[ "${base,,}" == ${pattern,,} ]] && matches+=("$entry")
    done <<<"$zip_listing"

    if (( ${#matches[@]} == 0 )); then
        say "  ✗ $name: no .apworld matching '$pattern' inside the release zip"
        return 1
    elif (( ${#matches[@]} > 1 )); then
        # one say, so the list is printed above the status block, not into it
        printf -v list '\n      %s' "${matches[@]##*/}"
        say "  ✗ $name: release zip holds several .apworld files, set apworld_filename:$list"
        return 1
    fi

    member="${matches[0]}"
    extracted="$TMP_DIR/extracted.apworld"
    if ! extract_member "$tmp_download" "$member" "$extracted"; then
        say "  ✗ $name: could not extract $member"
        rm -f "$extracted"
        return 1
    fi

    rm -f "$tmp_download"
    tmp_download="$extracted"
    # .apworld files are themselves zips
    if ! zip_listing=$(unzip -Z1 "$tmp_download" 2>/dev/null); then
        say "  ✗ $name: extracted file is not a valid .apworld"
        return 1
    fi
    asset_name="${member##*/}"
    debug "bundle member: $member"
    status "📦 extracted $asset_name"
}

# One cfg: check it, and update it if needed. Returns 2 to stop the whole run.
process_item() {
    local i="$1"
    cfg_file="${cfg_files[$i]}"
    name="${cfg_file##*/}"
    name="${name%.apworld.cfg}"

    PROGRESS_DONE=$i
    PROGRESS_LABEL="$name"
    STATUS=""
    block_redraw

    load_cfg "$cfg_file"
    debug "cfg: manager=${manager:-?} version=${current_version:-none} installed_file=${installed_file:-none} last_checked=${last_checked:-never}"

    installed_path=$(find_installed "$dir")
    if [[ -n "$installed_path" ]]; then
        debug "installed file: ${installed_path##*/}"
    else
        debug "not installed yet: installing it"
    fi

    if [[ "$force" == false && -n "$installed_path" && "${last_checked:-}" == "$today" ]]; then
        status_final "✓ already checked today (${current_version:-unknown})"
        return 0
    fi

    # a 304 has no download URL, so ask for the full list when installing; -f always does
    if [[ "${manager:-}" == github && ( "$force" == true || -z "$installed_path" ) ]]; then
        etag=""
        if [[ -n "$installed_path" ]]; then
            debug "full release list requested (-f)"
        else
            debug "full release list requested (not installed yet)"
        fi
    fi
    resolve_latest_asset; rc=$?
    if (( rc == 2 )); then
        # every further GitHub request would fail the same way
        say "  ✗ stopping, $(( ${#cfg_files[@]} - i - 1 )) more world(s) not checked"
        return 2
    elif (( rc )); then
        return 0
    fi

    if [[ -n "$installed_path" ]] && is_up_to_date "$installed_path"; then
        status_final "✓ up to date (${current_version:-$latest_tag})"
        [[ "$check_only" == true ]] || save_update_metadata "$cfg_file"
        return 0
    fi

    # -c: report it, download and write nothing
    if [[ "$check_only" == true ]]; then
        status_final "⬆ update available: $latest_tag ($asset_name)"
        return 0
    fi

    if [[ -n "$installed_path" ]]; then
        status "⬆ updating"
    else
        status "⬇ installing"
    fi

    # extract_member picks the unpacker by extension; every world is a zip
    tmp_download="$TMP_DIR/download.zip"

    curl_takeover
    if ! curl_run -fL "${CURL_DL[@]}" --progress-bar "$asset_url" -o "$tmp_download"; then
        curl_abandon
        say "  ✗ Failed to download $name"
        rm -f "$tmp_download"
        return 0
    fi
    curl_handback
    debug "downloaded to $tmp_download"

    if ! zip_listing=$(unzip -Z1 "$tmp_download" 2>/dev/null); then
        say "  ✗ $name: download is not a valid .apworld (zip)"
        rm -f "$tmp_download"
        return 0
    fi
    if ! unbundle_apworld; then
        rm -f "$tmp_download"
        return 0
    fi

    mapfile -t top_dirs < <(awk -F/ 'NF>1 && $1!="" {print $1}' <<<"$zip_listing" | sort -u)
    if [[ -n "${install_name:-}" ]]; then
        target_name="$install_name"
    elif (( ${#top_dirs[@]} == 1 )); then
        target_name="${top_dirs[0]}.apworld"
    else
        # no single module folder to name it after; never install a non-.apworld name
        target_name="$asset_name"
        [[ "${target_name,,}" == *.apworld ]] || target_name="$name.apworld"
    fi

    debug "module folder(s): ${top_dirs[*]:-none}; installing as $target_name${install_name:+ (install_name)}"
    if (( ${#top_dirs[@]} != 1 )) || [[ "${target_name%.apworld}" != "${top_dirs[0]}" ]]; then
        say "  ⚠ $name: $target_name doesn't match module folder (${top_dirs[*]:-none})"
    fi

    target="$dir/$target_name"
    [[ -f "$target" ]] && backup_file "$target"
    [[ -n "$installed_path" && "$installed_path" != "$target" && -f "$installed_path" ]] && \
        backup_file "$installed_path"

    mv "$tmp_download" "$target"
    chmod 644 "$target"
    [[ -n "$installed_path" && "$installed_path" != "$target" ]] && debug "replaced ${installed_path##*/}; old copies in $OLD_DIR/"

    installed_file="$target_name"
    save_update_metadata "$cfg_file"
    status_final "✓ updated to $latest_tag ($target_name)"
}

# Walks every cfg; a function of its own so -d can time the whole run.
run_items() {
    for i in "${!cfg_files[@]}"; do
        commit_final
        timed "" process_item "$i" || { (( $? == 2 )) && break; }
    done
    return 0
}

main() {
    local force=false check_only=false arg
    for arg in "$@"; do
        case "$arg" in
            -f|--force) force=true ;;
            -c|--check) check_only=true ;;
            -d|--debug) DEBUG=1 ;;
            *)          echo "Usage: ${0##*/} [-f|--force] [-c|--check] [-d|--debug]" >&2; exit 2 ;;
        esac
    done
    local today
    today=$(date +%F)

    # WORLDS_DIR from the environment points the script at another folder (tests)
    dir="${WORLDS_DIR:-/mnt/games_rando/Archipelago/custom_worlds}"
    CFG_DIR="$dir/.cfg"
    OLD_DIR="$dir/.old"
    TMP_DIR="$dir/.tmp"

    require_cmds curl jq unzip
    mkdir -p "$CFG_DIR" "$OLD_DIR" "$TMP_DIR"
    # left over from an interrupted earlier run
    rm -f "$TMP_DIR"/download.* "$TMP_DIR"/extracted.*

    GITHUB_HEADERS=$(mktemp)
    trap cleanup EXIT
    load_github_token

    shopt -s nullglob
    local cfg_files=("$CFG_DIR"/*.apworld.cfg)
    if (( ${#cfg_files[@]} == 0 )); then
        say "⚠ no *.apworld.cfg files in $CFG_DIR, nothing to do"
        return 0
    fi
    init_progress "${#cfg_files[@]}"

    local i rc cfg_file name installed_path
    local target target_name
    local -a top_dirs

    timed "total" run_items

    finish_progress
}

main "$@"
