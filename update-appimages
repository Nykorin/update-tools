#!/usr/bin/env bash
# update-appimages.sh
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/progress.sh
[[ -f "$SCRIPT_DIR/lib/progress.sh" ]] && source "$SCRIPT_DIR/lib/progress.sh"

# Staged files, global so the EXIT trap can remove them after a Ctrl+C.
tmp_download="" tmp_extract_dir="" DESKTOP_TMP=""

cleanup() {
    rm -f "$GITHUB_HEADERS"
    [[ -n "$tmp_download" ]] && rm -f "$tmp_download"
    [[ -n "$tmp_extract_dir" ]] && rm -rf "$tmp_extract_dir"
    [[ -n "$DESKTOP_TMP" ]] && rm -rf "$DESKTOP_TMP"
    return 0
}

# Upstream names carry versions, so one folder per app keeps .old/ at one
# previous version each instead of growing with every update. The current
# file(s) wait in a pending folder until the new AppImage is in place, so a
# failed install never costs the existing backup.
stash_old() {
    local pending="$OLD_DIR/.$app_name.pending"
    rm -rf "$pending"
    mkdir -p "$pending"
    mv "$@" "$pending/"
}
keep_stash() {
    rm -rf "${OLD_DIR:?}/$app_name"
    mv "$OLD_DIR/.$app_name.pending" "$OLD_DIR/$app_name"
}
# Put the stashed file(s) back where they were.
unstash() {
    local pending="$OLD_DIR/.$app_name.pending" f
    for f in "$pending"/*; do mv "$f" "$APPIMAGES_DIR/"; done
    rmdir "$pending"
}

desktop_entry_path() { echo "$HOME/.local/share/applications/${1}.desktop"; }

ensure_desktop_entry() {
    [[ -f "$(desktop_entry_path "$1")" ]] || generate_desktop_entry "$1" "$2"
}

icon_exists() {
    find -L "$1" -maxdepth 1 \
        \( -iname "$2.png" -o -iname "$2.svg" -o -iname "$2.xpm" -o -iname "$2.ico" \) \
        -print -quit 2>/dev/null
}

# $1 dir, $2 maxdepth (empty = unlimited), $3 non-empty = pick by version sort
# (scalable first, else the largest size). Needed for icon-theme trees, where
# find's own order is arbitrary and could hand back a 16x16 icon.
find_icon() {
    local -a args=(-L "$1")
    [[ -n "$2" ]] && args+=(-maxdepth "$2")
    args+=(\( -iname "*.png" -o -iname "*.svg" \))
    if [[ -n "${3:-}" ]]; then
        find "${args[@]}" 2>/dev/null | sort -rV | head -n 1
    else
        find "${args[@]}" -print -quit 2>/dev/null
    fi
}

generate_desktop_entry() {
    local app_name="$1" appimage_file="$2"
    local icon_dest="$ICONS_DIR/$app_name"
    local desktop_dest; desktop_dest=$(desktop_entry_path "$app_name")
    mkdir -p "$ICONS_DIR" "${desktop_dest%/*}"
    local tmp_extract; tmp_extract=$(mktemp -d -p "$STAGE_DIR")
    DESKTOP_TMP="$tmp_extract"

    if ! (cd "$tmp_extract" && "$appimage_file" --appimage-extract &>/dev/null); then
        say "  ✗ Failed to extract AppImage contents for $app_name"
        rm -rf "$tmp_extract"; DESKTOP_TMP=""; return 1
    fi

    local squashfs_root="$tmp_extract/squashfs-root"
    local embedded_desktop
    embedded_desktop=$(find -L "$squashfs_root" -maxdepth 1 -iname "*.desktop" -print -quit)
    [[ -z "$embedded_desktop" ]] && \
        embedded_desktop=$(find "$squashfs_root" -maxdepth 3 -iname "*.desktop" -print -quit)

    if [[ -z "$(icon_exists "$ICONS_DIR" "$app_name")" ]]; then
        # tiers, in priority order, as "dir:maxdepth:sorted"
        local icon_src="" tier dir maxdepth sorted
        for tier in "$squashfs_root:1:" "$squashfs_root/usr/share/icons::sorted" "$squashfs_root::"; do
            IFS=: read -r dir maxdepth sorted <<<"$tier"
            icon_src=$(find_icon "$dir" "$maxdepth" "$sorted")
            [[ -n "$icon_src" ]] && break
        done
        if [[ -n "$icon_src" ]]; then
            cp "$icon_src" "${icon_dest}.${icon_src##*.}"
            status "🖼 icon extracted"
        else
            say "  ⚠ No icon found for $app_name"
        fi
    fi

    local icon_path; icon_path=$(icon_exists "$ICONS_DIR" "$app_name")

    if [[ -n "$embedded_desktop" ]]; then
        sed -e "s|^Icon=.*|Icon=${icon_path:-}|" \
            -e "s|^TryExec=.*|TryExec=$appimage_file|" \
            -e "s|^Exec=.*|Exec=env DESKTOPINTEGRATION=1 $appimage_file %f|" \
            "$embedded_desktop" > "$desktop_dest"
        status "󰴚 desktop entry built from embedded metadata"
    else
        cat > "$desktop_dest" <<EOF
[Desktop Entry]
Type=Application
Name=$app_name
Icon=${icon_path:-}
TryExec=$appimage_file
Exec=env DESKTOPINTEGRATION=1 $appimage_file %f
Categories=Utility;
X-AppImage-Name=$app_name
EOF
        say "  ⚠ No embedded .desktop found, generated minimal entry for $app_name"
    fi
    rm -rf "$tmp_extract"
    DESKTOP_TMP=""
}

# One cfg: check it, and update it if needed. Returns 2 to stop the whole run.
process_item() {
    local i="$1"
    cfg_file="${cfg_files[$i]}"
    app_name="${cfg_file##*/}"
    app_name="${app_name%.appimage.cfg}"

    PROGRESS_DONE=$i
    PROGRESS_LABEL="$app_name"
    STATUS=""
    block_redraw

    load_cfg "$cfg_file"
    debug "cfg: manager=${manager:-?} version=${current_version:-none} last_checked=${last_checked:-never}"

    appimage_file=$(find_installed "$APPIMAGES_DIR")
    # cfgs from before installed_file: the AppImage is named after the cfg
    [[ -n "$appimage_file" ]] || \
        appimage_file=$(find "$APPIMAGES_DIR" -maxdepth 1 -iname "${app_name}.appimage" -type f -print -quit)
    if [[ -z "$appimage_file" ]]; then
        say "⚠ $app_name: no AppImage found, skipping"
        return 0
    fi

    debug "installed file: ${appimage_file##*/}"
    if [[ "$force" == false && "${last_checked:-}" == "$today" ]]; then
        status_final "✓ already checked today (${current_version:-unknown})"
        ensure_desktop_entry "$app_name" "$appimage_file"
        return 0
    fi

    # -f asks GitHub for the full release list, not just "changed since?" (a static
    # item's etag is the server's file ETag, which it still needs to compare)
    [[ "$force" == true && "${manager:-}" == github ]] && etag=""
    if ! resolve_latest_asset; then
        return 0
    fi

    if is_up_to_date "$appimage_file"; then
        status_final "✓ up to date (${current_version:-$latest_tag})"
        save_update_metadata "$cfg_file" "installed_file=${appimage_file##*/}"
        ensure_desktop_entry "$app_name" "$appimage_file"
        return 0
    fi

    status "⬆ updating"
    # staged next to the AppImages (same disk, not RAM-backed /tmp): installing is a rename
    tmp_download=$(mktemp -p "$STAGE_DIR" --suffix="-$asset_name")

    curl_takeover
    # -f: an HTTP error page must never replace a working AppImage
    if ! curl_run -fL "${CURL_DL[@]}" --progress-bar "$asset_url" -o "$tmp_download"; then
        curl_abandon
        say "  ✗ Failed to download update for $app_name"
        rm -f "$tmp_download"
        return 0
    fi
    curl_handback
    debug "downloaded to $tmp_download"

    # Handle archived AppImages
    new_appimage="$tmp_download"
    new_name="$asset_name"
    tmp_extract_dir=""
    case "$asset_name" in
        *.tar.gz|*.tgz|*.tar.xz|*.tar.bz2|*.tar|*.zip)
            tmp_extract_dir=$(mktemp -d -p "$STAGE_DIR")
            if ! extract_archive "$tmp_download" "$tmp_extract_dir"; then
                say "  ✗ Failed to extract archive for $app_name"
                rm -f "$tmp_download"; rm -rf "$tmp_extract_dir"
                return 0
            fi
            new_appimage=$(find "$tmp_extract_dir" -iname "*.appimage" -type f -print -quit)
            debug "archive holds ${new_appimage:-no AppImage}"
            new_name="${new_appimage##*/}"
            if [[ -z "$new_appimage" ]]; then
                say "  ✗ No AppImage found inside extracted archive for $app_name"
                rm -f "$tmp_download"; rm -rf "$tmp_extract_dir"
                return 0
            fi
            ;;
    esac

    # keep the upstream name and casing (versions included), like the ISOs; a
    # download URL without a usable AppImage name keeps the current one
    [[ "${new_name,,}" == *.appimage ]] || new_name="${appimage_file##*/}"
    local target="$APPIMAGES_DIR/$new_name"
    # a stray file already using the new name is backed up too, never overwritten
    if [[ "$target" != "$appimage_file" && -e "$target" ]]; then
        stash_old "$appimage_file" "$target"
    else
        stash_old "$appimage_file"
    fi
    # both moves are renames on one disk; should the second still fail, put the old one back
    if ! mv "$new_appimage" "$target"; then
        unstash
        say "  ✗ $app_name: could not install the new AppImage, kept the old one"
        rm -f "$tmp_download"
        [[ -n "$tmp_extract_dir" ]] && rm -rf "$tmp_extract_dir"
        return 0
    fi
    keep_stash
    debug "previous version moved to $OLD_DIR/$app_name/"
    chmod +x "$target"
    rm -f "$tmp_download"
    [[ -n "$tmp_extract_dir" ]] && rm -rf "$tmp_extract_dir"
    debug "installed as $new_name"

    generate_desktop_entry "$app_name" "$target"

    save_update_metadata "$cfg_file" "installed_file=$new_name"
    status_final "✓ updated to $latest_tag"
}

# Walks every cfg; a function of its own so -d can time the whole run.
run_items() {
    for i in "${!cfg_files[@]}"; do
        commit_final
        timed "" process_item "$i" || { (( $? == 2 )) && break; }
    done
    return 0
}

main() {
    local force=false arg
    for arg in "$@"; do
        case "$arg" in
            -f|--force) force=true ;;
            -d|--debug) DEBUG=1 ;;
            *)          echo "Usage: ${0##*/} [-f|--force] [-d|--debug]" >&2; exit 2 ;;
        esac
    done
    local today
    today=$(date +%F)

    APPIMAGES_DIR="$HOME/AppImages"
    CFG_DIR="$APPIMAGES_DIR/.cfg"
    ICONS_DIR="$APPIMAGES_DIR/.icons"
    OLD_DIR="$APPIMAGES_DIR/.old"

    require_cmds curl jq
    STAGE_DIR="$APPIMAGES_DIR/.tmp"
    mkdir -p "$CFG_DIR" "$ICONS_DIR" "$OLD_DIR"
    # anything left here is from an interrupted earlier run
    rm -rf "$STAGE_DIR"
    mkdir -p "$STAGE_DIR"

    GITHUB_HEADERS=$(mktemp)
    trap cleanup EXIT
    load_github_token

    shopt -s nullglob
    local cfg_files=("$CFG_DIR"/*.appimage.cfg)
    if (( ${#cfg_files[@]} == 0 )); then
        say "⚠ no *.appimage.cfg files in $CFG_DIR, nothing to do"
        return 0
    fi
    init_progress "${#cfg_files[@]}"

    local i cfg_file app_name appimage_file
    local new_appimage new_name

    timed "total" run_items

    finish_progress
}

main "$@"
