#!/usr/bin/env bash
# update-appimages.sh
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/progress.sh
[[ -f "$SCRIPT_DIR/lib/progress.sh" ]] && source "$SCRIPT_DIR/lib/progress.sh"

# Staged files, global so the EXIT trap can remove them after a Ctrl+C.
tmp_download="" tmp_extract_dir="" DESKTOP_TMP=""

cleanup() {
    rm -f "$GITHUB_HEADERS"
    [[ -n "$tmp_download" ]] && rm -f "$tmp_download"
    [[ -n "$tmp_extract_dir" ]] && rm -rf "$tmp_extract_dir"
    [[ -n "$DESKTOP_TMP" ]] && rm -rf "$DESKTOP_TMP"
    return 0
}

# Upstream names carry versions, so one folder per app keeps .old/ at one
# previous version each instead of growing with every update. The current
# file(s) wait in a pending folder until the new AppImage is in place, so a
# failed install never costs the existing backup.
stash_old() {
    local pending="$OLD_DIR/.$name.pending"
    rm -rf "$pending"
    mkdir -p "$pending"
    mv "$@" "$pending/"
}
keep_stash() {
    rm -rf "${OLD_DIR:?}/$name"
    mv "$OLD_DIR/.$name.pending" "$OLD_DIR/$name"
}
# Put the stashed file(s) back where they were.
unstash() {
    local pending="$OLD_DIR/.$name.pending" f
    for f in "$pending"/*; do mv "$f" "$dir/"; done
    rmdir "$pending"
}

desktop_entry_path() { echo "$HOME/.local/share/applications/${1}.desktop"; }

ensure_desktop_entry() {
    [[ -f "$(desktop_entry_path "$1")" ]] || generate_desktop_entry "$1" "$2"
}

icon_exists() {
    find -L "$1" -maxdepth 1 \
        \( -iname "$2.png" -o -iname "$2.svg" -o -iname "$2.xpm" -o -iname "$2.ico" \) \
        -print -quit 2>/dev/null
}

# $1 dir, $2 maxdepth (empty = unlimited), $3 non-empty = pick by version sort
# (scalable first, else the largest size). Needed for icon-theme trees, where
# find's own order is arbitrary and could hand back a 16x16 icon.
find_icon() {
    local -a args=(-L "$1")
    [[ -n "$2" ]] && args+=(-maxdepth "$2")
    args+=(\( -iname "*.png" -o -iname "*.svg" \))
    if [[ -n "${3:-}" ]]; then
        find "${args[@]}" 2>/dev/null | sort -rV | head -n 1
    else
        find "${args[@]}" -print -quit 2>/dev/null
    fi
}

generate_desktop_entry() {
    local name="$1" appimage_file="$2"
    local icon_dest="$ICONS_DIR/$name"
    local desktop_dest; desktop_dest=$(desktop_entry_path "$name")
    mkdir -p "$ICONS_DIR" "${desktop_dest%/*}"
    local tmp_extract="$TMP_DIR/desktop"
    rm -rf "$tmp_extract"
    mkdir -p "$tmp_extract"
    DESKTOP_TMP="$tmp_extract"

    if ! (cd "$tmp_extract" && "$appimage_file" --appimage-extract &>/dev/null); then
        say "  ✗ Failed to extract AppImage contents for $name"
        rm -rf "$tmp_extract"; DESKTOP_TMP=""; return 1
    fi

    local squashfs_root="$tmp_extract/squashfs-root"
    local embedded_desktop
    embedded_desktop=$(find -L "$squashfs_root" -maxdepth 1 -iname "*.desktop" -print -quit)
    [[ -z "$embedded_desktop" ]] && \
        embedded_desktop=$(find "$squashfs_root" -maxdepth 3 -iname "*.desktop" -print -quit)

    if [[ -z "$(icon_exists "$ICONS_DIR" "$name")" ]]; then
        # tiers, in priority order, as "dir:maxdepth:sorted"
        local icon_src="" tier icon_dir maxdepth sorted
        for tier in "$squashfs_root:1:" "$squashfs_root/usr/share/icons::sorted" "$squashfs_root::"; do
            IFS=: read -r icon_dir maxdepth sorted <<<"$tier"
            icon_src=$(find_icon "$icon_dir" "$maxdepth" "$sorted")
            [[ -n "$icon_src" ]] && break
        done
        if [[ -n "$icon_src" ]]; then
            cp "$icon_src" "${icon_dest}.${icon_src##*.}"
            status "🖼 icon extracted"
        else
            say "  ⚠ No icon found for $name"
        fi
    fi

    local icon_path; icon_path=$(icon_exists "$ICONS_DIR" "$name")

    if [[ -n "$embedded_desktop" ]]; then
        sed -e "s|^Icon=.*|Icon=${icon_path:-}|" \
            -e "s|^TryExec=.*|TryExec=$appimage_file|" \
            -e "s|^Exec=.*|Exec=env DESKTOPINTEGRATION=1 $appimage_file %f|" \
            "$embedded_desktop" > "$desktop_dest"
        status "󰴚 desktop entry built from embedded metadata"
    else
        cat > "$desktop_dest" <<EOF
[Desktop Entry]
Type=Application
Name=$name
Icon=${icon_path:-}
TryExec=$appimage_file
Exec=env DESKTOPINTEGRATION=1 $appimage_file %f
Categories=Utility;
X-AppImage-Name=$name
EOF
        say "  ⚠ No embedded .desktop found, generated minimal entry for $name"
    fi
    rm -rf "$tmp_extract"
    DESKTOP_TMP=""
}

# One cfg: check it, and update it if needed. Returns 2 to stop the whole run.
process_item() {
    local i="$1"
    cfg_file="${cfg_files[$i]}"
    name="${cfg_file##*/}"
    name="${name%.appimage.cfg}"

    PROGRESS_DONE=$i
    PROGRESS_LABEL="$name"
    STATUS=""
    block_redraw

    load_cfg "$cfg_file"
    debug "cfg: manager=${manager:-?} version=${current_version:-none} last_checked=${last_checked:-never}"

    installed_path=$(find_installed "$dir")
    if [[ -n "$installed_path" ]]; then
        debug "installed file: ${installed_path##*/}"
    else
        debug "not installed yet: installing it"
    fi

    if [[ "$force" == false && -n "$installed_path" && "${last_checked:-}" == "$today" ]]; then
        status_final "✓ already checked today (${current_version:-unknown})"
        [[ "$check_only" == true ]] || ensure_desktop_entry "$name" "$installed_path"
        return 0
    fi

    # -f, or a first install that needs the download URL, asks GitHub for the full
    # release list, not just "changed since?" (a static item's etag is the server's
    # file ETag, which it still needs to compare)
    if [[ "${manager:-}" == github && ( "$force" == true || -z "$installed_path" ) ]]; then
        etag=""
    fi
    if ! resolve_latest_asset; then
        return 0
    fi

    if [[ -n "$installed_path" ]] && is_up_to_date "$installed_path"; then
        status_final "✓ up to date (${current_version:-$latest_tag})"
        [[ "$check_only" == true ]] && return 0
        installed_file="${installed_path##*/}"
        save_update_metadata "$cfg_file"
        ensure_desktop_entry "$name" "$installed_path"
        return 0
    fi

    # -c: report it, download and write nothing
    if [[ "$check_only" == true ]]; then
        status_final "⬆ update available: $latest_tag ($asset_name)"
        return 0
    fi

    if [[ -n "$installed_path" ]]; then
        status "⬆ updating"
    else
        status "⬇ installing"
    fi

    # staged next to the AppImages (same disk, not RAM-backed /tmp): installing is a rename
    # the asset's name keeps an archive's extension, which decides how it's unpacked
    tmp_download="$TMP_DIR/download-$asset_name"

    curl_takeover
    # -f: an HTTP error page must never replace a working AppImage
    if ! curl_run -fL "${CURL_DL[@]}" --progress-bar "$asset_url" -o "$tmp_download"; then
        curl_abandon
        say "  ✗ Failed to download update for $name"
        rm -f "$tmp_download"
        return 0
    fi
    curl_handback
    debug "downloaded to $tmp_download"

    # archived AppImages: extract, then install the AppImage inside
    new_appimage="$tmp_download"
    new_name="$asset_name"
    tmp_extract_dir=""
    case "$asset_name" in
        *.tar.gz|*.tgz|*.tar.xz|*.tar.bz2|*.tar|*.zip)
            tmp_extract_dir="$TMP_DIR/archive"
            rm -rf "$tmp_extract_dir"
            mkdir -p "$tmp_extract_dir"
            if ! extract_archive "$tmp_download" "$tmp_extract_dir"; then
                say "  ✗ Failed to extract archive for $name"
                rm -f "$tmp_download"; rm -rf "$tmp_extract_dir"
                return 0
            fi
            new_appimage=$(find "$tmp_extract_dir" -iname "*.appimage" -type f -print -quit)
            debug "archive holds ${new_appimage:-no AppImage}"
            new_name="${new_appimage##*/}"
            if [[ -z "$new_appimage" ]]; then
                say "  ✗ No AppImage found inside extracted archive for $name"
                rm -f "$tmp_download"; rm -rf "$tmp_extract_dir"
                return 0
            fi
            ;;
    esac

    # keep the upstream name and casing (versions included), like the ISOs; a
    # download URL without a usable AppImage name keeps the current one, or on a
    # first install takes the cfg's name
    if [[ "${new_name,,}" != *.appimage ]]; then
        if [[ -n "$installed_path" ]]; then
            new_name="${installed_path##*/}"
        else
            new_name="$name.AppImage"
        fi
    fi

    local target="$dir/$new_name"
    local -a aside=()
    [[ -n "$installed_path" ]] && aside+=("$installed_path")
    # a stray file already using the new name is backed up too, never overwritten
    [[ "$target" != "$installed_path" && -e "$target" ]] && aside+=("$target")
    (( ${#aside[@]} )) && stash_old "${aside[@]}"

    # all moves are renames on one disk; should the last still fail, put everything back
    if ! mv "$new_appimage" "$target"; then
        (( ${#aside[@]} )) && unstash
        say "  ✗ $name: could not install the new AppImage, kept the old one"
        rm -f "$tmp_download"
        [[ -n "$tmp_extract_dir" ]] && rm -rf "$tmp_extract_dir"
        return 0
    fi
    if (( ${#aside[@]} )); then
        keep_stash
        debug "previous version moved to $OLD_DIR/$name/"
    fi
    chmod +x "$target"
    rm -f "$tmp_download"
    [[ -n "$tmp_extract_dir" ]] && rm -rf "$tmp_extract_dir"
    debug "installed as $new_name"

    generate_desktop_entry "$name" "$target"

    installed_file="$new_name"
    save_update_metadata "$cfg_file"
    status_final "✓ updated to $latest_tag"
}

# Walks every cfg; a function of its own so -d can time the whole run.
run_items() {
    for i in "${!cfg_files[@]}"; do
        commit_final
        timed "" process_item "$i" || { (( $? == 2 )) && break; }
    done
    return 0
}

usage() {
    cat <<EOF
Usage: ${0##*/} [OPTIONS]
Check and update the AppImages in ~/AppImages, one NAME.appimage.cfg per app
in ~/AppImages/.cfg. A cfg whose AppImage isn't there yet is installed.

Options:
  -c, --check       only look for updates: download and change nothing
  -f, --force       check every app, even ones already checked today
  -r, --root DIR    use DIR instead of ~/AppImages (desktop entries still go
                    to ~/.local/share/applications)
  -d, --debug       explain each decision and time each app (or DEBUG=1)
  -h, --help        show this help
EOF
}

main() {
    local force=false check_only=false
    parse_flags "$@"
    local today
    today=$(date +%F)

    APPIMAGE_DIR="${ROOT_ARG:-$HOME/AppImages}"
    APPIMAGE_DIR="${APPIMAGE_DIR%/}"
    if [[ ! -d "$APPIMAGE_DIR" ]]; then
        echo "ERROR: $APPIMAGE_DIR not found. Point to the AppImages folder with -r DIR." >&2
        exit 1
    fi
    dir="$APPIMAGE_DIR"
    CFG_DIR="$dir/.cfg"
    ICONS_DIR="$dir/.icons"
    OLD_DIR="$dir/.old"

    require_cmds curl jq
    TMP_DIR="$dir/.tmp"
    mkdir -p "$CFG_DIR" "$ICONS_DIR" "$OLD_DIR"
    # anything left here is from an interrupted earlier run
    rm -rf "$TMP_DIR"
    mkdir -p "$TMP_DIR"

    GITHUB_HEADERS=$(mktemp)
    trap cleanup EXIT
    load_github_token

    shopt -s nullglob
    local cfg_files=("$CFG_DIR"/*.appimage.cfg)
    if (( ${#cfg_files[@]} == 0 )); then
        say "⚠ no *.appimage.cfg files in $CFG_DIR, nothing to do"
        return 0
    fi
    init_progress "${#cfg_files[@]}"

    local i cfg_file name installed_path
    local new_appimage new_name

    timed "total" run_items

    finish_progress
}

main "$@"
