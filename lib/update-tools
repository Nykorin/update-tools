# shellcheck shell=bash
# The main every updater shares, sourced after common.sh. Each updater sets
# ITEM_TYPE (app, apw or iso: picks its settings below and its require_cmds),
# and defines prepare_dir (its other folders and an interrupted run's leftovers)
# and process_item, then calls main "$@". The EXIT trap's cleanup is in common.sh.

# Each updater's settings, by ITEM_TYPE: ITEM_EXT (its cfgs are NAME.ITEM_EXT.cfg,
# and the help text calls an item that), ITEM_MODE (for installed files; empty
# leaves the mode alone), USAGE_ABOUT and USAGE_ROOT for usage in
# common.sh, DEFAULT_DIR, and NOT_FOUND_HINT (the end of the folder-not-found
# error). The help text's continuation lines start at column 0 because they're
# printed as written.
# shellcheck disable=SC2034  # used by usage in common.sh
item_settings() {
    case "$ITEM_TYPE" in
        app)
            ITEM_EXT="appimage"
            ITEM_MODE="755"
            USAGE_ABOUT="Check and update the AppImages in ~/AppImages, one NAME.appimage.cfg per app
in ~/AppImages/.cfg. A cfg whose AppImage isn't there yet is installed."
            # shellcheck disable=SC2088  # a literal ~ for the help text, not a path
            USAGE_ROOT="~/AppImages (desktop entries still go
                    to ~/.local/share/applications)"
            DEFAULT_DIR="$HOME/AppImages"
            NOT_FOUND_HINT="Point to the AppImages folder with -r DIR."
            ;;

        apw)
            ITEM_EXT="apworld"
            ITEM_MODE="644"
            USAGE_ABOUT="Check and update the Archipelago worlds in
/mnt/games_rando/Archipelago/custom_worlds, one NAME.apworld.cfg per world in
its .cfg folder. A cfg whose world isn't there yet is installed."
            USAGE_ROOT="the custom_worlds folder above"
            DEFAULT_DIR="/mnt/games_rando/Archipelago/custom_worlds"
            NOT_FOUND_HINT="Is the games drive mounted? Point to the folder with -r DIR."
            ;;

        iso)
            ITEM_EXT="iso"
            # exFAT has no modes
            ITEM_MODE=""
            USAGE_ABOUT="Check and update the ISOs on the Ventoy drive (/mnt/ventoy/_ISO), one
NAME.iso.cfg per ISO in its .cfg folder, whose folder= key names the ISO's
folder below it (like Linux/Fedora/Fedora). Every download is checksum-verified
before it replaces anything."
            USAGE_ROOT="/mnt/ventoy/_ISO (the drive's _ISO folder)"
            DEFAULT_DIR="/mnt/ventoy/_ISO"
            NOT_FOUND_HINT="Is the Ventoy drive mounted? Point to it with -r DIR."
            ;;

        *)
            echo "ERROR: unknown updater type '$ITEM_TYPE'" >&2
            exit 1
            ;;
    esac
}

# The "up to date" result, the same for every updater: the version, then the cfg
# saved (not with -c, which writes nothing); AppImages also refresh their desktop
# entry.
report_up_to_date() {
    status_final "✓ up to date (${latest_tag:-$installed_file})"
    [[ "$check_only" == true ]] && return 0
    save_update_metadata "$cfg_file"
    case "$ITEM_TYPE" in
        app) ensure_desktop_entry "$name" "$installed_path" ;;
    esac
}

# Walks every cfg; a function of its own so -d can time the whole run.
run_items() {
    for i in "${!cfg_files[@]}"; do
        commit_final
        timed "" process_item "$i" || { (( $? == 2 )) && break; }
    done
    return 0
}

# shellcheck disable=SC2034  # its locals are read by each updater's process_item
main() {
    local force=false check_only=false
    item_settings
    parse_flags "$@"
    local today
    today=$(date +%F)

    dir="${ROOT_ARG:-$DEFAULT_DIR}"
    dir="${dir%/}"
    if [[ ! -d "$dir" ]]; then
        echo "ERROR: $dir not found. $NOT_FOUND_HINT" >&2
        exit 1
    fi
    CFG_DIR="$dir/.cfg"

    require_cmds "$ITEM_TYPE"
    mkdir -p "$CFG_DIR"
    prepare_dir

    start_run

    shopt -s nullglob
    local cfg_files=("$CFG_DIR"/*."$ITEM_EXT".cfg)
    if (( ${#cfg_files[@]} == 0 )); then
        say "⚠ no *.$ITEM_EXT.cfg files in $CFG_DIR, nothing to do"
        return 0
    fi
    init_progress "${#cfg_files[@]}"

    # the per-item variables all three share; process_item declares the rest
    local i cfg_file name installed_path

    timed "total" run_items

    finish_progress
}
